-fb8e17376eca/resource/4da598bc-39ed-484d-8127-470895bc01b3/download/sei64003486notatecnica1301.pdf", "webstore_url": null, "last_modified": "2026-09-01T12:28:15.988691", "position": 48, "revision_id": "6a105517-e47e-4702-ad84-4c67955bae3f", "resource_type": null}], "num_resources": 49, "tags": [{"vocabulary_id": null, "state": "active", "display_name": "95", "id": "9584e9c0-b273-45b9-a6bf-17f277b91d48", "name": "95"}, {"vocabulary_id": null, "state": "active", "display_name": "Resultado Fiscal", "id": "067e5794-70e1-40cc-9c89-5e61c855d904", "name": "Resultado Fiscal"}, {"vocabulary_id": null, "state": "active", "display_name": "Resultado do Tesouro Nacional", "id": "fdbb398b-567c-4a50-80b5-062e8737065c", "name": "Resultado do Tesouro Nacional"}, {"vocabulary_id": null, "state": "active", "display_name": "emenda constitucional", "id": "6e282a34-69f5-4a67-becc-410974b5a3ad", "name": "emenda constitucional"}, {"vocabulary_id": null, "state": "active", "display_name": "pol\u00edtica fiscal", "id": "878c9880-508e-41f8-a3d1-522b29696577", "name": "pol\u00edtica fiscal"}, {"vocabulary_id": null, "state": "active", "display_name": "sujeitas ao teto", "id": "5920de2c-4e69-4982-aa38-8a31958e463f", "name": "sujeitas ao teto"}, {"vocabulary_id": null, "state": "active", "display_name": "teto dos gastos", "id": "3ba65367-0c56-43d6-9575-4ad20f8afdf0", "name": "teto dos gastos"}], "groups": [], "license_id": "odc-odbl", "relationships_as_subject": [], "organization": {"description": "", "created": "2015-11-13T17:19:12.490872", "title": "CESEF", "name": "cesef", "is_organization": true, "state": "active", "image_url": "", "revision_id": "ea3463c2-e9f8-4f1e-bca6-6a4f5549db35", "type": "organization", "id": "789269c1-c1d4-40b5-94f5-65ca39c335b6", "approval_status": "approved"}, "name": "despesas-e-transferencias-totais", "isopen": true, "url": "", "notes": "A base de Despesas e Transfer\u00eancias totais da Uni\u00e3o \u00e9 um dos documentos p\u00fablicos mais completos em termos de detalhamento dos gastos da Uni\u00e3o. Al\u00e9m dos m\u00faltiplos par\u00e2metros cont\u00e1beis-or\u00e7ament\u00e1rios, a base acrescenta a classifica\u00e7\u00e3o presente no Resultado do Tesouro Nacional (RTN), classifica\u00e7\u00e3o dos gastos sujeitos ao Teto dos Gastos (EC n\u00ba 95/2016) e a classifica\u00e7\u00e3o dos gastos sujeitos aos limites para as dota\u00e7\u00f5es de despesas prim\u00e1rias previstos na Lei Complementar n\u00ba 200/2023 (LC 200). A partir de simples manipula\u00e7\u00f5es \u00e9 poss\u00edvel saber, por exemplo, a despesa de pessoal, investimento, despesa por \u00f3rg\u00e3o, etc.\r\n\r\nRessalta-se que, a partir de 2024, passou a vigorar o limite de despesas previsto na LC 200, em substitui\u00e7\u00e3o ao antigo teto de gastos previsto na Emenda Constitucional n\u00ba 95/2016 (EC 95). O Tesouro Nacional disponibiliza as Bases de Dados de 2008 em diante com gastos classificados de acordo com o Resultado do Tesouro Nacional. Com rela\u00e7\u00e3o ao limite de despesas, de 2016 at\u00e9 2023 as bases de dados tamb\u00e9m est\u00e3o classificadas de acordo com a sujei\u00e7\u00e3o ao Regime Fiscal da EC 95, sendo substitu\u00edda, nas bases a partir de 2024, pela classifica\u00e7\u00e3o de acordo com o limite da LC 200.\r\n\r\nPor fim, \u00e9 importante mencionar que tamb\u00e9m est\u00e3o disponibilizadas as notas t\u00e9cnicas de metodologia e atualiza\u00e7\u00e3o de filtros, tanto do antigo teto de gastos previsto na EC 95, quanto do limite de despesas atualmente em vigor, previsto na LC 200.\r\n ", "owner_org": "789269c1-c1d4-40b5-94f5-65ca39c335b6", "extras": [{"key": "Categoria do e-VoG", "value": "Economia e Finan\u00e7as"}, {"key": "Data de in\u00edcio dos dados", "value": "Janeiro/2008"}, {"key": "Frequ\u00eancia de atualiza\u00e7\u00e3o", "value": "Mensal"}, {"key": "resource_group", "value": "Notas T\u00e9cnicas LC 200"}], "license_url": "http://www.opendefinition.org/licenses/odc-odbl", "title": "Despesas e Transfer\u00eancias Totais da Uni\u00e3o (crit\u00e9rio valor pago)", "revision_id": "fa610984-5c45-4d6d-9433-e6d087ecf4e8"}, {"license_title": "Open Data Commons Open Database License (ODbL)", "maintainer": "", "relationships_as_object": [], "private": false, "maintainer_email": "", "num_tags": 4, "id": "a49d6433-ab0b-41d2-bf79-4d16973831f3", "metadata_created": "2017-03-17T12:53:51.185814", "metadata_modified": "2021-12-08T17:38:42.546664", "author": "CCONT", "author_email": "", "state": "active", "version": "", "creator_user_id": "c2130be3-05d8-4627-9a63-382d67a835a8", "type": "dataset", "resources": [{"resource_group": "", "cache_last_updated": null, "package_id": "a49d6433-ab0b-41d2-bf79-4d16973831f3", "webstore_last_updated": null, "id": "ccbabe2c-6929-49fb-aca4-482e91572b1f", "size": "41704", "state": "active", "hash": "", "description": "", "format": "PDF", "mimetype_inner": null, "url_type": "upload", "mimetype": null, "cache_url": null, "name": "Metadados - Limites da LRF para a Uni\u00e3o Despesas com Pessoal", "created": "2017-03-17T10:03:39.188237", "url": "https://www.tesourotransparente.gov.br/ckan/dataset/a49d6433-ab0b-41d2-bf79-4d16973831f3/resource/ccbabe2c-6929-49fb-aca4-482e91572b1f/download/metadados-limites-da-lrf-para-a-uniao-despesas-com-pessoal.pdf", "webstore_url": null, "last_modified": null, "position": 0, "revision_id": "10ab0157-21ca-4184-9510-402d872a76c4", "resource_type": null}, {"resource_group": "", "cache_last_updated": null, "package_id": "a49d6433-ab0b-41d2-bf79-4d16973831f3", "webstore_last_updated": null, "id": "92580d1e-0e30-45c9-9aa1-7a05586a30da", "size": "4174", "state": "active", "hash": "", "description": "S\u00e9rie hist\u00f3rica quadrimestral das Despesas com Pessoal para fins de apura\u00e7\u00e3o do limite estabelecido pela LRF. Os valores se referem sempre \u00e0 despesa executada nos \u00faltimos doze meses em rela\u00e7\u00e3o ao quadrimestre de refer\u00eancia.", "format": "CSV", "mimetype_inner": null, "url_type": "upload", "mimetype": null, "cache_url": null, "name": "Despesas com Pessoal do Poder Executivo Federal - Quadrimestral - 2000-atual", "created": "2017-03-17T07:06:18.461178", "url": "https://www.tesourotransparente.gov.br/ckan/dataset/a49d6433-ab0b-41d2-bf79-4d16973831f3/resource/92580d1e-0e30-45c9-9aa1-7a05586a30da/download/limites-da-lrf-para-a-uniao---despesas-com-pessoal.csv", "webstore_url": null, "last_modified": "2018-11-20T12:50:16.005290", "position": 1, "revision_id": "3823447a-7047-415d-a842-06588462c7d1", "resource_type": null}], "num_resources": 2, "tags": [{"vocabulary_id": null, "state": "active", "display_name": "Contabilidade P\u00fablica", "id": "f0e1d5c0-cd61-4fad-9346-9f3d888e3466", "name": "Contabilidade P\u00fablica"}, {"vocabulary_id": null, "state": "active", "display_name": "Execu\u00e7\u00e3o Or\u00e7ament\u00e1ria", "id": "33ef2910-6491-4225-8545-c2943061a02c", "name": "Execu\u00e7\u00e3o Or\u00e7ament\u00e1ria"}, {"vocabulary_id": null, "state": "active", "display_name": "Lei de Responsabilidade Fiscal", "id": "2f193993-da42-484f-a151-765da6db4ace", "name": "Lei de Responsabilidade Fiscal"}, {"vocabulary_id": null, "state": "active", "display_name": "Responsabilidade Fiscal da Uni\u00e3o", "id": "3a16693f-6f2b-4b5f-a3d4-c03aa1e03b14", "name": "Responsabilidade Fiscal da Uni\u00e3o"}], "groups": [], "license_id": "odc-odbl", "relationships_as_subject": [], "organization": {"description": "", "created": "2015-11-16T09:06:57.486592", "title": "CCONT", "name": "ccont", "is_organization": true, "state": "active", "image_url": "", "revision_id": "e0860f5a-2ddf-4a71-9cfb-091c537eabbb", "type": "organization", "id": "3ccc54f3-5edb-407f-a79f-a0a935dfaf2a", "approval_status": "approved"}, "name": "limites-da-lrf-para-a-uniao-despesas-com-pessoal-do-poder-executivo-federal", "isopen": true, "url": "http://www.tesouro.gov.br/web/stn/-/relatorio-de-gestao-fiscal", "notes": "S\u00e9rie hist\u00f3rica quadrimestrais dos valores referentes aos limites da LRF para Despesa com Pessoal do Poder Executivo Federal.\r\n\r\nO artigo de abertura da Lei de Responsabilidade Fiscal, em seu par\u00e1grafo primeiro, declara:\r\n\r\n\"A responsabilidade na gest\u00e3o fiscal pressup\u00f5e a a\u00e7\u00e3o planejada e transparente, em que se previnem riscos e corrigem desvios capazes de afetar o equil\u00edbrio das contas p\u00fablicas, mediante o cumprimento de metas de resultados entre receitas e despesas e a obedi\u00eancia a limites e condi\u00e7\u00f5es no que tange a ren\u00fancia de receita, gera\u00e7\u00e3o de despesas com pessoal, da seguridade social e outras, d\u00edvidas consolidada e mobili\u00e1ria, opera\u00e7\u00f5es de cr\u00e9dito, inclusive por antecipa\u00e7\u00e3o de receita, concess\u00e3o de garantia e inscri\u00e7\u00e3o em Restos a Pagar.\"\r\n\r\nEste conjunto de dados demonstra o cumprimento, por parte da Uni\u00e3o (no caso das Despesas com Pessoal, apenas para o Poder Executivo), dos limites estabelecidos pela LRF, a saber:\r\n\r\ndespesa total com pessoal;\r\nd\u00edvida consolidada;\r\nconcess\u00e3o de garantias e contragarantias; e\r\nopera\u00e7\u00f5es de cr\u00e9dito.\r\nO cumprimento desses limites s\u00e3o demonstrados por meio do Relat\u00f3rio de Gest\u00e3o Fiscal, um dos instrumentos de transpar\u00eancia da gest\u00e3o fiscal criados pela LRF. Esse relat\u00f3rio \u00e9 emitido quadrimestralmente pelos titulares dos Poderes e dos \u00f3rg\u00e3os referidos no art. 20 da Lei.\r\n\r\nOs relat\u00f3rios do Poder Executivo Federal (em PDF) podem ser acessados na p\u00e1gina: http://www.tesouro.gov.br/web/stn/-/relatorio-de-gestao-fiscal\r\n\r\nAs sa\u00eddas de dados disponibilizadas aqui representam os principais valores apurados especificamente para a verifica\u00e7\u00e3o dos limites mencionados acima. Assim, deve-se ter em mente que as informa\u00e7\u00f5es deste conjunto de dados seguem metodologia pr\u00f3pria, definida de acordo com os crit\u00e9rios estabelecidos pela LRF, pelo Manual de Demonstrativos Fiscais e eventuais recomenda\u00e7\u00f5es e determina\u00e7\u00f5es do Tribunal de Contas da Uni\u00e3o, que realiza a verifica\u00e7\u00e3o do cumprimento desses limites a cada quadrimestre. Dessa forma, podem eventualmente existir diverg\u00eancias entre esses valores e outros divulgados neste portal no \u00e2mbito de outros conjuntos de dados, com nomes semelhantes.", "owner_org": "3ccc54f3-5edb-407f-a79f-a0a935dfaf2a", "extras": [{"key": "Categoria do e-VoG", "value": "Economia e Finan\u00e7as"}, {"key": "Data de In\u00edcio dos Dadps", "value": "Dezembro de 2000"}, {"key": "Frequ\u00eancia de Atualiza\u00e7\u00e3o", "value": "Quadrimestral"}, {"key": "resource_group", "value": ""}], "license_url": "http://www.opendefinition.org/licenses/odc-odbl", "title": "Limites da LRF para a Uni\u00e3o: Despesas com Pessoal do Poder Executivo Federal", "revision_id": "525a09f5-780d-48a5-aa95-555d7061ba28"}, {"license_title": "Open Data Commons Open Database License (ODbL)", "maintainer": "COPEM", "relationships_as_object": [], "private": false, "maintainer_email": "", "num_tags": 4, "id": "4d6b967d-1bc5-4f80-92ba-05e4498c111a", "metadata_created": "2017-04-12T20:04:50.553987", "metadata_modified": "2024-07-08T15:09:19.084918", "author": "", "author_email": "", "state": "active", "version": "", "creator_user_id": "4ad3c52b-ca95-4b2e-9d5d-16ffe184588a", "type": "dataset", "resources": [{"resource_group": "", "cache_last_updated": null, "package_id": "4d6b967d-1bc5-4f80-92ba-05e4498c111a", "webstore_last_updated": null, "id": "b2c8aa27-5551-41de-82cb-c325e87550cc", "size": "4305", "state": "active", "hash": "", "description": "S\u00e9rie hist\u00f3rica anual, posi\u00e7\u00e3o de 31 de dezembro, da D\u00edvida Consolidada L\u00edquida dos Estados.\r\n\r\nValores em R$ 1.000,00.", "format": "CSV", "mimetype_inner": null, "url_type": "upload", "mimetype": null, "cache_url": null, "name": "D\u00edvida Consolidada L\u00edquida", "created": "2017-04-12T05:09:51