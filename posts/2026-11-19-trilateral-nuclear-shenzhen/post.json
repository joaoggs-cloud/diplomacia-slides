{
  "slug": "2026-11-19-trilateral-nuclear-shenzhen",
  "titulo_interno": "Trilateral Trump-Xi-Putin em Shenzhen: o que está em jogo no controle de armas nucleares",
  "status": "aguardando_aprovacao",
